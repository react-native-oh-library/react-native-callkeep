{
  "name": "@react-native-ohos/react-native-callkeep",
  "version": "4.3.14-0.0.1",
  "description": "iOS 10 CallKit and Android ConnectionService Framework For React Native",
  "main": "index.js",
  "scripts": {
    "codegen-lib": "react-native codegen-lib-harmony --no-safety-check --npm-package-name react-native-callkeep --cpp-output-path ./harmony/call_keep/src/main/cpp/generated --ets-output-path ./harmony/call_keep/src/main/ets/generated --turbo-modules-spec-paths ./src  --arkts-components-spec-paths ./src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-native-webrtc/react-native-callkeep.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "author": "See AUTHORS file",
  "maintainers": [
    "See AUTHORS file"
  ],
  "contributors": [
    "See AUTHORS file"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/react-native-webrtc/react-native-callkeep/issues"
  },
  "homepage": "https://github.com/react-native-webrtc/react-native-callkeep#readme",
  "keywords": [
    "harmony"
  ],
  "harmony": {
    "alias": "react-native-callkeep",
    "autolinking": {
        "etsPackageClassName":"CallKeepPackage",
        "cppPackageClassName":"CallKeepPackage",
        "cmakeLibraryTargetName": "rnoh_call_keep", 
        "ohPackageName": "@react-native-ohos/react-native-callkeep"
    }
  },
  "typings": "./index.d.ts",
  "peerDependencies": {
    "react-native": ">=0.40.0"
  },
  "devDependencies": {
    "react-native": ">=0.40.0"
  },
  "dependencies": {
    "react-native-callkeep": "4.3.14"
  }
}